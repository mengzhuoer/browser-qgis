  "layers": {
    "classes": {
      "file": "classes.tif",
      "kind": "categorical",
      "title": "分区（离散）",
      "classes": {
        "1": "类别一",
        "2": "类别二",
        "3": "类别三",
        "4": "类别四",
        "5": "类别五",
        "6": "类别六"
      }
    },
    "surface": {
      "file": "surface.tif",
      "kind": "continuous",
      "title": "曲面（连续）"
    }
  },
  "vectors": {
    "boundary": {
      "file": "boundary.geojson",
      "title": "示例范围"
    }
  }
